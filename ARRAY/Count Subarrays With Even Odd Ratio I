class Solution {
public:
    int countRatioSubarrays(vector<int>& nums, int a, int b) {
        int x=0, y=0, count=0;

        for(int i=0; i<nums.size(); i++){
            for(int j=i; j<nums.size(); j++){
                if(nums[j]%2==0){
                    x++;
                }else{
                    y++;
                }
                if(y!=0 && (1LL * x * b <= 1LL * a * y))count++;
            }
            x=0;y=0;
        }
        return count;
    }
};