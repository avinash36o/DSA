class Solution {
public:
    int candy(vector<int>& ratings) {
        int n=ratings.size(), ans=0;
        vector<int>v(n,1);
//traverse from start and share candy based on left student ranking
        for(int i=1; i<n; i++){
            if(ratings[i]>ratings[i-1]){
                v[i]=v[i-1]+1;
            }
        }
//traverse from end and share candy based on right student ranking
        for(int i=n-1; i>0; i--){
            if(ratings[i-1]>ratings[i]){
                v[i-1]=max(v[i]+1, v[i-1]);
            }
            ans+=v[i-1];
        }
        return ans+v[n-1];
    }
};