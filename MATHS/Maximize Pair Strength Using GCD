class Solution {
public:
    long long maxPairStrength(vector<int>& nums) {
        long long ans=0;
        for(int i=0; i<nums.size(); i++){
            for(int j=i+1; j<nums.size(); j++){
                long long product=(long long)nums[i] * nums[j];
                long long g=(long long)gcd(nums[i], nums[j]);
                long long curr=product / (g*g);
                ans=max(ans,curr);
            }
        }
        return ans;
    }
};